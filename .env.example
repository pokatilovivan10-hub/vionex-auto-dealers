# ------------------------------------------------------------
# PUBLIC SITE SETTINGS
# ------------------------------------------------------------
SITE_MODE=demo
SITE_ADDRESS=http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080
PUBLIC_SITE_NAME=VIONEX LEADS
PUBLIC_SITE_SHORT_NAME=VIONEX
PUBLIC_TAGLINE=Управляемая B2B-лидогенерация под ключ
PUBLIC_PHONE=
PUBLIC_EMAIL=
PUBLIC_TELEGRAM_URL=
PUBLIC_CALENDAR_URL=
PUBLIC_RESPONSE_TIME=Свяжемся в рабочее время после проверки задачи

# ------------------------------------------------------------
# LEGAL DETAILS — required when SITE_MODE=production
# ------------------------------------------------------------
COMPANY_LEGAL_NAME=
COMPANY_TAX_ID=
COMPANY_REGISTRATION_ID=
COMPANY_ADDRESS=
PRIVACY_EMAIL=
DATA_RETENTION_DAYS=365

# ------------------------------------------------------------
# CRM / WEBHOOK DELIVERY — optional
# The site always stores a local backup in ./data/leads.ndjson.
# ------------------------------------------------------------
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_TOKEN=
LEAD_WEBHOOK_TIMEOUT_MS=7000

# Optional Telegram notification. Never expose these values in frontend code.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------
# SERVER
# ------------------------------------------------------------
PORT=8080
HOST=127.0.0.1
TRUST_PROXY=1
LOG_LEVEL=info
DATA_DIR=./data
FORM_RATE_LIMIT_PER_15_MIN=8
EVENT_RATE_LIMIT_PER_MIN=120
MIN_FORM_FILL_MS=1200

# ------------------------------------------------------------
# VIONEX CMS / ADMIN PANEL
# Create the first administrator with: npm run admin:create
# ------------------------------------------------------------
CMS_DATABASE_PATH=
CMS_SESSION_HOURS=8
CMS_MAX_UPLOAD_MB=8
CMS_LOGIN_ATTEMPTS_PER_15_MIN=10
